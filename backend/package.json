{
  "name": "music-room-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Music Room API: Track Vote, Playlist Editor and Control Delegation",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "tsx scripts/local-db.ts",
    "db:docker": "tsx scripts/docker-db.ts",
    "mail:local": "maildev --ip 127.0.0.1 --web-ip 127.0.0.1",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "docs:openapi": "tsx scripts/export-openapi.ts",
    "load": "tsx load/run.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/formbody": "^9.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@prisma/client": "^6.19.3",
    "@sinclair/typebox": "^0.34.52",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.7",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "autocannon": "^8.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "maildev": "^3.0.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true,
    "@embedded-postgres/darwin-x64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-arm@18.4.0-beta.17": true,
    "@embedded-postgres/linux-arm64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-ia32@18.4.0-beta.17": true,
    "@embedded-postgres/linux-ppc64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
