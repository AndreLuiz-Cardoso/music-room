# Copy to .env and fill in. .env is ignored by git: never commit real credentials.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Public URL used to build the links sent by email (verification / password reset)
PUBLIC_URL=http://localhost:3000

# PostgreSQL. Choose the password (change-me below): `make db` (embedded server) and `make db-docker`
# create the server with these user, password, database and port; connection_limit = size of the Prisma pool.
# The tests use the same server with the musicroom_test database (or TEST_DATABASE_URL).
DATABASE_URL=postgresql://musicroom:change-me@localhost:5433/musicroom?connection_limit=20

# At least 32 random characters (the API refuses this example value):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-change-me-change-me-change-me

# Comma separated list of allowed browser origins (empty = mobile only, no browser CORS)
CORS_ORIGINS=http://localhost:8081

# Behind a reverse proxy (TLS), the proxy addresses allowed to set X-Forwarded-For, comma separated,
# or "true" to trust any. Empty = the client address is the TCP peer (direct access, LAN).
# Required behind a proxy: empty, every client gets the proxy's address and shares its rate limit.
TRUST_PROXY=

# Rate limiting, requests per minute: RATE_LIMIT_MAX per signed-in user (or per IP for anonymous
# requests), AUTH_RATE_LIMIT_MAX per IP on login, register and the email routes
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
BCRYPT_ROUNDS=12

# SMTP. These values send to the local inbox of `make mail` (read at http://localhost:1080, nothing leaves
# the machine). For a real provider, set its host, port 587 and credentials. Empty SMTP_HOST: emails are
# printed in the server log instead.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Music Room <no-reply@musicroom.local>"

# Google: every OAuth client id allowed as ID token audience (web, android, ios), comma separated
GOOGLE_CLIENT_IDS=
# Facebook app (developers.facebook.com)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Music catalog: "deezer" (public Deezer API) or "fake" (offline, for tests and load tests)
TRACK_CATALOG=deezer
