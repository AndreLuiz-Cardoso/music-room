# Copy to .env and fill in. .env is ignored by git: never commit real credentials.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Public URL used to build the links sent by email (verification / password reset)
PUBLIC_URL=http://localhost:3000

# PostgreSQL. connection_limit = size of the Prisma pool (default: 2 x CPU + 1).
# `npm run db:local` starts an embedded server matching this URL.
DATABASE_URL=postgresql://musicroom:musicroom@localhost:5433/musicroom?connection_limit=20

# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-change-me-change-me-change-me

# Comma separated list of allowed browser origins (empty = mobile only, no browser CORS)
CORS_ORIGINS=http://localhost:8081

# Rate limiting (requests per minute and per IP)
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
BCRYPT_ROUNDS=12

# SMTP. When SMTP_HOST is empty, emails are printed in the server log instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Music Room <no-reply@musicroom.local>"

# Google: every OAuth client id allowed as ID token audience (web, android, ios), comma separated
GOOGLE_CLIENT_IDS=
# Facebook app (developers.facebook.com)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Music catalog: "deezer" (public Deezer API) or "fake" (offline, for tests and load tests)
TRACK_CATALOG=deezer
