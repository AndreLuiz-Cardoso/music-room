# Copy to .env (ignored by git). Every EXPO_PUBLIC_* value is embedded in the app bundle:
# only put public identifiers here, never secrets.

# Default back-end address (development builds can also change it at runtime by opening /server,
# e.g. http://localhost:8081/server on the web).
# Android emulator: http://10.0.2.2:3000 (the web app and the iOS simulator then use localhost)
# Physical device: http://<your-LAN-ip>:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Google sign-in: the WEB client id (its id tokens are accepted by the back-end GOOGLE_CLIENT_IDS)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only: reversed iOS client id, e.g. com.googleusercontent.apps.1234-abcd
GOOGLE_IOS_URL_SCHEME=

# Facebook login (developers.facebook.com > your app > settings)
EXPO_PUBLIC_FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=

# Native identifiers (must match the ones registered on Google / Facebook)
ANDROID_PACKAGE=com.musicroom.app
IOS_BUNDLE_ID=com.musicroom.app
